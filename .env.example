# Copy this file to ".env" (setup.bat does it for you) and paste your keys.
# .env is in .gitignore, so it is never uploaded to GitHub.
#
# Free Gemini key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Free Groq key: https://console.groq.com/keys
GROQ_API_KEY=
#
# Optional: force a model. Leave empty to auto-pick the newest one available.
GEMINI_MODEL=
GROQ_MODEL=
